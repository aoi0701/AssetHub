# =================================================================
# AssetHub - Production / Demo Environment Configuration Example
# =================================================================
# Copy this file to .env.demo (or .env) and fill in real values.
# NEVER commit credentials or secrets to version control.

# --- Django Security ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production!
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.assethub.example.com,localhost,127.0.0.1,backend
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# --- Database Configuration (PostgreSQL 16) ---
DB_NAME=assethub
DB_USER=assethub_user
DB_PASSWORD=change-me-to-a-strong-database-password
DB_HOST=db
DB_PORT=5432
TEST_DB_NAME=test_assethub

# --- CORS Settings ---
# Comma-separated list of allowed origins. Cloudflare Pages (*.pages.dev) is allowed by regex by default.
CORS_ALLOWED_ORIGINS=https://assethub.pages.dev,https://assethub.example.com,http://localhost:5173

# --- Cloudflare Tunnel Configuration ---
TUNNEL_ID=your-cloudflare-tunnel-uuid-here
API_HOSTNAME=api.assethub.example.com

# --- Cloudflare R2 Object Storage (File / Avatar Uploads) ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=assethub-storage
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# --- Cloudflare Worker AI Service ---
AI_WORKER_URL=https://assethub-ai-worker.<subdomain>.workers.dev
AI_SERVICE_TOKEN=your-ai-service-shared-token-at-least-32-chars

# --- Frontend Build Environment (Set in Cloudflare Pages dashboard) ---
# VITE_API_BASE_URL=https://api.assethub.example.com
