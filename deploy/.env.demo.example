# =================================================================
# AssetHub - Cloudflare Edge Demo Environment Configuration Example
# =================================================================
# Copy this file to .env.demo (never commit .env.demo with real secrets).
#
# Architecture Overview:
#   - Primary Operational DB: Cloudflare D1 via Worker Bridge (SQLite at Edge)
#   - Object Storage: Cloudflare R2 (Private Bucket, SigV4 Presigned URLs, 900s TTL)
#   - AI Microservice: Cloudflare Workers AI (@cf/meta/llama-3.1-8b-instruct-fp8)
#   - Ingress: Cloudflare Tunnel (cloudflared Quick Tunnel or Named Tunnel)
#   - Frontend: Cloudflare Pages (React 18 + Vite SPA)
#
# =================================================================
# THỨ TỰ CẤU HÌNH BIẾN KHI DEPLOY THỰC TẾ (DEPLOYMENT PHASING):
# Lưu ý: Tất cả các lệnh dưới đây đều chạy từ thư mục gốc của repo (repo root).
# Cảnh báo: Tuyệt đối không chạy 'npm install' bừa bãi hoặc auto-download các gói npx không rõ nguồn gốc.
# =================================================================
# BƯỚC 1: Tài nguyên Cloudflare có sẵn / đã biết
#   - Cloudflare Account ID: 5e76c2bf4e09587a010d31ea416ec8d3
#   - D1 Database Name: assethub-test-d1 (ID: 3850e3a1-7c57-42f4-afd6-1fa1655bbcf1)
#   - R2 Bucket Name: assethub-attachments
#   - R2 Endpoint URL: https://5e76c2bf4e09587a010d31ea416ec8d3.r2.cloudflarestorage.com
#   - D1 Bridge Worker URL: https://assethub-test-worker.hnhoa494-assethub.workers.dev
#   - Workers AI URL: https://assethub-ai-worker.hnhoa494-assethub.workers.dev
#
# BƯỚC 2: Tạo và điền Secrets nội bộ (TRƯỚC KHI KHỞI CHẠY BACKEND)
#   - DJANGO_SECRET_KEY: Chuỗi ngẫu nhiên 64 ký tự (chạy: python -c 'import secrets; print(secrets.token_urlsafe(50))')
#   - D1_BRIDGE_SECRET_TOKEN: Khớp secret put trên assethub-test-worker (BRIDGE_SECRET_TOKEN)
#   - AI_SERVICE_TOKEN: Để trống vì AI Worker chưa được deploy thực tế lên cloud (tránh gọi với token giả định)
#   - R2_ACCESS_KEY_ID & R2_SECRET_ACCESS_KEY: Để trống vì R2 chưa kích hoạt trên Cloudflare Dashboard (lỗi 10042)
#
# BƯỚC 3: Khởi chạy Demo Backend & Mở Cloudflare Tunnel (Port 8001)
#   - Khởi động backend demo (từ repo root):
#     docker compose -p assethub-demo -f deploy/docker-compose.demo.yml --env-file deploy/.env.demo up -d --no-build --pull never backend
#   - Chạy Quick Tunnel: cloudflared tunnel --url http://127.0.0.1:8001
#   - Thu được URL public: https://<demo-tunnel-subdomain>.trycloudflare.com
#   - Cập nhật DJANGO_ALLOWED_HOSTS với <demo-tunnel-subdomain>.trycloudflare.com (hoặc .trycloudflare.com)
#
# BƯỚC 4: Build và Deploy Frontend lên Cloudflare Pages
#   - Chạy từ repo root:
#     VITE_API_BASE_URL=https://<demo-tunnel-subdomain>.trycloudflare.com npm run build --prefix frontend
#   - Deploy (không tự ý npm install / cài npx package mới):
#     npx wrangler pages deploy frontend/dist --project-name assethub
#   - Thu được URL Pages: https://assethub.pages.dev (hoặc https://<pages-project>.pages.dev)
#
# BƯỚC 5: Đồng bộ CORS & Recreate Backend Service
#   - Kiểm tra CORS_ALLOWED_ORIGINS và CORS_EXTRA_REGEX bên dưới (mặc định đã hỗ trợ https://assethub.pages.dev).
#   - Tái tạo container backend khi cập nhật .env.demo (chạy từ repo root, KHÔNG dùng restart vì không nạp lại env, KHÔNG dùng backend-demo):
#     docker compose -p assethub-demo -f deploy/docker-compose.demo.yml --env-file deploy/.env.demo up -d --no-build --pull never backend
#   - CSP connect-src trong frontend/public/_headers đã whitelist sẵn *.trycloudflare.com, *.pages.dev, *.r2.cloudflarestorage.com
# =================================================================

# --- Django Security & Runtime ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-string-for-demo!
DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS: Chấp nhận localhost, backend nội bộ docker, wildcard .trycloudflare.com và tên miền tùy chọn
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,.trycloudflare.com,<demo-tunnel-subdomain>.trycloudflare.com,api.assethub.example.com
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# --- Demo Backend Port ---
# Chạy port 8001 để tuyệt đối không xung đột với container assethub-backend-1 chính đang chạy port 8000
DEMO_BACKEND_PORT=8001

# --- Cloudflare D1 Primary Operational Database ---
USE_D1_DATABASE=True
D1_DATABASE_NAME=assethub-test-d1
D1_BRIDGE_URL=https://assethub-test-worker.hnhoa494-assethub.workers.dev
D1_BRIDGE_SECRET_TOKEN=placeholder_d1_bridge_secret_token
D1_TIMEOUT=45.0

# --- Read-only PostgreSQL Source (Optional reconciliation alias) ---
# Note: POSTGRES_RO_USER và POSTGRES_RO_PASSWORD phải là user chỉ đọc (read-only role).
# Nếu để trống, alias 'postgres' sẽ bị vô hiệu hóa an toàn, không thể ghi ngoài ý muốn.
POSTGRES_DB=assethub
POSTGRES_RO_USER=
POSTGRES_RO_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- CORS Settings ---
# CORS_ALLOWED_ORIGINS: Domain frontend được phép gọi API (Pages production hoặc local dev)
CORS_ALLOWED_ORIGINS=https://assethub.pages.dev,http://localhost:5173,http://127.0.0.1:5173
# CORS_EXTRA_REGEX: Để trống để Django tự động dùng default regex r"^https:\/\/(?:[a-z0-9-]+\.)?assethub\.pages\.dev$"
# giúp khớp an toàn assethub.pages.dev và preview subdomains của nó, chặn toàn bộ attacker/project khác trên pages.dev.
CORS_EXTRA_REGEX=

# --- Cloudflare Tunnel Configuration ---
# Dùng khi cấu hình Named Tunnel (cloudflared service). Nếu dùng Quick Tunnel thì không cần TUNNEL_ID.
TUNNEL_ID=placeholder-cloudflare-tunnel-uuid
API_HOSTNAME=api.assethub.example.com

# --- Cloudflare R2 Object Storage (Presigned URL 900s TTL) ---
# Để trống R2_ACCESS_KEY_ID và R2_SECRET_ACCESS_KEY do R2 chưa được kích hoạt trên Cloudflare Dashboard (lỗi 10042).
# Khi để trống, runtime sẽ tự động chạy an toàn ở chế độ skip/disabled mode.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=assethub-attachments
R2_ENDPOINT_URL=https://5e76c2bf4e09587a010d31ea416ec8d3.r2.cloudflarestorage.com
R2_PRESIGNED_URL_EXPIRE_SECONDS=900

# --- Cloudflare Worker AI Service ---
# Microservice AI phân loại tài sản thiết bị độc lập (@cf/meta/llama-3.1-8b-instruct-fp8)
# URL dự kiến, chưa deploy thực tế trên Cloudflare Workers.
AI_WORKER_URL=https://assethub-ai-worker.hnhoa494-assethub.workers.dev
# Để trống AI_SERVICE_TOKEN để không gọi service chưa deploy với token giả định không hợp lệ.
AI_SERVICE_TOKEN=
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# --- Frontend Build Environment (Set biến môi trường này khi chạy 'npm run build' cho Pages) ---
# VITE_API_BASE_URL=https://<demo-tunnel-subdomain>.trycloudflare.com
