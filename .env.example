# Django configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL database configuration (default development)
DB_NAME=assethub
DB_USER=assethub_user
DB_PASSWORD=assethub_password
DB_HOST=db
DB_PORT=5432

# Test Database configuration
TEST_DB_NAME=test_assethub

# Cloudflare D1 Database Configuration (opt-in runtime for edge demo)
USE_D1_DATABASE=False
D1_DATABASE_NAME=assethub-test-d1
D1_BRIDGE_URL=https://assethub-test-worker.<subdomain>.workers.dev
D1_BRIDGE_SECRET_TOKEN=placeholder_d1_bridge_secret_token
D1_TIMEOUT=45.0

# Read-only PostgreSQL alias for data reconciliation when in D1 mode (optional)
# Must have read-only privileges. If unset/empty, DATABASES['postgres'] is disabled.
POSTGRES_DB=assethub
POSTGRES_RO_USER=
POSTGRES_RO_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & Security configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGIN_REGEXES defaults to r"^https:\/\/(?:[a-z0-9-]+\.)?assethub\.pages\.dev$"

# Frontend API Base URL (origin of backend, e.g. https://<tunnel>.trycloudflare.com; no trailing slash)
VITE_API_BASE_URL=

# Demo seed config
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=demo_password_placeholder

# Cloudflare R2 / S3 Storage Credentials
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=assethub-attachments
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PRESIGNED_URL_EXPIRE_SECONDS=900

# Cloudflare Worker AI configuration
AI_SERVICE_TOKEN=dev-ai-secret-token-2026
AI_WORKER_URL=http://127.0.0.1:8787
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
