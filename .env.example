# Django configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL database configuration
DB_NAME=assethub
DB_USER=assethub_user
DB_PASSWORD=assethub_password
DB_HOST=db
DB_PORT=5432

# Test Database configuration
TEST_DB_NAME=test_assethub

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo seed config
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=demo_password_placeholder
